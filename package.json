{
  "name": "bill-app-offline",
  "version": "1.0.0",
  "description": "Offline billing web application",
  "scripts": {
    "build:css": "tailwindcss -i ./static/src/input.css -o ./static/dist/css/output.css --minify",
    "watch:css": "tailwindcss -i ./static/src/input.css -o ./static/dist/css/output.css --watch",
    "build:js": "node scripts/build-js.js",
    "build": "npm run build:css && npm run build:js",
    "dev": "tailwindcss -i ./static/src/input.css -o ./static/dist/css/output.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13"
  },
  "dependencies": {
    "flowbite": "^2.5.2"
  }
}
